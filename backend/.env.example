# Node & Server Configuration
NODE_ENV=development
PORT=4000
ALLOWED_ORIGIN=http://localhost:3000

# PostgreSQL 16 + pgvector Database
DATABASE_URL=postgresql://yash:password@localhost:5433/yash_ai

# Redis 7 Cache & Rate Limiting
REDIS_URL=redis://localhost:6379

# AI Provider API Keys (Keep Server-Side ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Service 1: Ask Yash (Gemini) Limits
ASK_MODEL=gemini-3.6-flash
ASK_MAX_INPUT_TOKENS=800
ASK_MAX_OUTPUT_TOKENS=1000
ASK_SESSION_LIMIT=8
ASK_SESSION_TOKEN_BUDGET=10000

# Service 2: RAG Engine (OpenAI) Limits
RAG_CHAT_MODEL=gpt-4o-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_MAX_QUERY_TOKENS=500
RAG_MAX_OUTPUT_TOKENS=1000
RAG_SESSION_LIMIT=3
RAG_SESSION_TOKEN_BUDGET=10000
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.30

# Global Abuse & Rate Controls
GLOBAL_DAILY_TOKEN_LIMIT=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5
MAX_CONCURRENT_REQUESTS_PER_SESSION=1
REQUEST_TIMEOUT_MS=20000

# Cache TTLs (Seconds)
CACHE_RESPONSE_TTL_SECONDS=3600
CACHE_EMBEDDING_TTL_SECONDS=86400

# Admin & Emergency Kill Switches
ADMIN_API_KEY=dev_admin_secret_key_12345
ASK_YASH_ENABLED=true
RAG_ENABLED=true
