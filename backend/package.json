{
  "name": "yash-ai-backend",
  "version": "1.0.0",
  "description": "Production-minded AI Gateway and RAG Engine backend for YASH.AI portfolio",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "ingest": "tsx scripts/ingest.ts"
  },
  "keywords": [
    "ai-gateway",
    "rag",
    "gemini",
    "openai",
    "pgvector",
    "redis"
  ],
  "author": "Yash",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/google": "^4.0.57",
    "@ai-sdk/openai": "^4.0.51",
    "@google/generative-ai": "^0.24.0",
    "ai": "^7.0.84",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "openai": "^4.52.0",
    "pg": "^8.12.0",
    "pgvector": "^0.1.8",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^11.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
