# ==============================================================================
# YASH.AI Frontend Environment Configuration
# ==============================================================================

# API Base URL:
# - In Development: Leave empty to use the Vite dev server proxy (/api -> http://localhost:4000)
#   Or set to your local backend URL: http://localhost:4000
# - In Production: Set to your deployed production backend API URL
#   Example: https://api.yash.ai or https://yash-ai-backend.onrender.com
VITE_API_BASE_URL=

# Optional: Custom backend target for Vite dev proxy (default: http://localhost:4000)
VITE_DEV_BACKEND_URL=http://localhost:4000

